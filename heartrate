<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
  <title>Karvonen HR Calculator - Sports Science</title>
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
  <script src="https://cdn.tailwindcss.com"></script>
  <style>
    body { background-color: #0b0f19; color: #f8fafc; touch-action: manipulation; }
    .safe-top { padding-top: max(12px, env(safe-area-inset-top)); }
    .safe-bottom { padding-bottom: max(16px, env(safe-area-inset-bottom)); }
    input[type="number"]::-webkit-inner-spin-button, 
    input[type="number"]::-webkit-outer-spin-button { 
      -webkit-appearance: none; 
      margin: 0; 
    }
  </style>
</head>
<body class="min-h-[100dvh] flex flex-col justify-between font-sans safe-top safe-bottom px-4">

  <!-- HEADER -->
  <header class="py-3 flex items-center justify-between border-b border-slate-800">
    <div class="flex items-center gap-2">
      <div class="w-8 h-8 rounded-lg bg-rose-500/20 text-rose-400 border border-rose-500/40 flex items-center justify-center font-black text-sm">HR</div>
      <div>
        <h1 class="text-sm font-bold text-white leading-none">目標心拍数・運動強度マネージャー</h1>
        <span class="text-[10px] text-slate-400 font-mono">KARVONEN LOAD ENGINE</span>
      </div>
    </div>
    <span class="text-[10px] px-2 py-0.5 rounded bg-slate-800 text-slate-300 font-mono">百武スポーツ事業部</span>
  </header>

  <!-- MAIN VIEW -->
  <main class="flex-1 flex flex-col gap-3 py-3 max-w-md mx-auto w-full">

    <!-- 年齢 & 推定最大心拍数 -->
    <div class="bg-slate-900 border border-slate-800 rounded-2xl p-3.5 shadow-xl flex items-center justify-between">
      <div class="w-1/2 pr-3 border-r border-slate-800">
        <label class="text-[11px] text-slate-400 block mb-1">年齢 (Age)</label>
        <div class="flex items-center bg-slate-950 border border-slate-700 rounded-xl px-3 py-1.5 focus-within:border-cyan-400">
          <input type="number" id="inputAge" value="18" class="w-full bg-transparent text-white font-mono text-base font-bold outline-none" inputmode="numeric">
          <span class="text-slate-500 text-xs">歳</span>
        </div>
      </div>
      <div class="w-1/2 pl-3 flex flex-col justify-center">
        <span class="text-[10px] text-slate-400">推定最大心拍数 (220-年齢)</span>
        <div class="flex items-baseline gap-1 mt-0.5">
          <span id="maxHrLabel" class="text-xl font-black font-mono text-slate-200">202</span>
          <span class="text-[10px] text-slate-500">bpm</span>
        </div>
      </div>
    </div>

    <!-- 心拍入力カード（直打ち vs 20秒切替） -->
    <div class="bg-slate-900 border border-slate-800 rounded-2xl p-3.5 flex flex-col gap-3 shadow-xl">
      
      <!-- 安静時心拍数 -->
      <div class="flex flex-col gap-1.5 pb-3 border-b border-slate-800/80">
        <div class="flex items-center justify-between">
          <span class="text-xs font-bold text-slate-300">① 安静時心拍数 (Resting HR)</span>
          <!-- 切替タブ -->
          <div class="flex bg-slate-950 p-0.5 rounded-lg border border-slate-800 text-[10px]">
            <button id="restModeWatchBtn" class="px-2 py-0.5 rounded font-bold bg-cyan-600 text-white transition-all">⌚ Watch (bpm)</button>
            <button id="restModeManualBtn" class="px-2 py-0.5 rounded text-slate-400 hover:text-white transition-all">✋ 手動 (20秒)</button>
          </div>
        </div>

        <div class="flex items-center gap-3">
          <div class="flex-1 flex items-center bg-slate-950 border border-slate-700 rounded-xl px-3 py-1.5 focus-within:border-cyan-400">
            <input type="number" id="inputRestVal" value="60" class="w-full bg-transparent text-cyan-400 font-mono text-base font-bold outline-none" inputmode="numeric">
            <span id="restUnitLabel" class="text-slate-500 text-xs font-mono">bpm</span>
          </div>
          <div class="w-24 text-right">
            <span class="text-[10px] text-slate-400 block leading-tight">換算値</span>
            <span class="font-mono text-xs font-bold text-white"><span id="restCalcLabel">60</span> bpm</span>
          </div>
        </div>
      </div>

      <!-- 運動後心拍数 -->
      <div class="flex flex-col gap-1.5">
        <div class="flex items-center justify-between">
          <span class="text-xs font-bold text-slate-300">② 運動後心拍数 (Exercise HR)</span>
          <!-- 切替タブ -->
          <div class="flex bg-slate-950 p-0.5 rounded-lg border border-slate-800 text-[10px]">
            <button id="workModeWatchBtn" class="px-2 py-0.5 rounded font-bold bg-rose-600 text-white transition-all">⌚ Watch (bpm)</button>
            <button id="workModeManualBtn" class="px-2 py-0.5 rounded text-slate-400 hover:text-white transition-all">✋ 手動 (20秒)</button>
          </div>
        </div>

        <div class="flex items-center gap-3">
          <div class="flex-1 flex items-center bg-slate-950 border border-rose-500/50 rounded-xl px-3 py-1.5 focus-within:border-rose-400">
            <input type="number" id="inputWorkVal" value="150" class="w-full bg-transparent text-rose-300 font-mono text-base font-bold outline-none" inputmode="numeric">
            <span id="workUnitLabel" class="text-slate-500 text-xs font-mono">bpm</span>
          </div>
          <div class="w-24 text-right">
            <span class="text-[10px] text-slate-400 block leading-tight">換算値</span>
            <span class="font-mono text-xs font-bold text-white"><span id="workCalcLabel">150</span> bpm</span>
          </div>
        </div>
      </div>
    </div>

    <!-- 今回の運動強度 (HRR カルボーネン) -->
    <div class="bg-gradient-to-br from-slate-900 to-slate-950 border border-rose-500/40 rounded-2xl p-4 flex items-center justify-between shadow-2xl relative overflow-hidden">
      <div class="flex flex-col">
        <span class="text-[10px] font-bold text-rose-400 tracking-wider uppercase font-mono">TRAINING INTENSITY (HRR)</span>
        <span class="text-xs text-slate-300 mt-0.5">今回の運動強度（カルボーネン）</span>
        <span id="intensityZoneBadge" class="inline-block mt-2 px-2.5 py-0.5 rounded-md text-[10px] font-bold bg-emerald-950 text-emerald-300 border border-emerald-700 w-fit">
          有酸素ベース構築 (Zone 2)
        </span>
      </div>
      <div class="flex items-baseline gap-1">
        <span id="intensityVal" class="text-5xl font-black font-mono text-rose-400">63</span>
        <span class="text-base font-bold text-slate-400">%</span>
      </div>
    </div>

    <!-- 目標心拍数テーブル -->
    <div class="bg-slate-900 border border-slate-800 rounded-2xl p-3.5 flex flex-col gap-2 shadow-xl">
      <div class="flex items-center justify-between">
        <span class="text-xs font-bold text-slate-300">目標運動強度テーブル (Target HR)</span>
        <span class="text-[9px] text-slate-500 font-mono">HR = (HRmax - HRrest) × % + HRrest</span>
      </div>

      <div class="grid grid-cols-2 gap-2 text-xs">
        <div class="flex items-center justify-between p-2 rounded-xl bg-slate-950 border border-slate-800">
          <span class="font-bold text-cyan-400">50% (回復・ウォーム)</span>
          <span id="target50" class="font-mono font-bold text-white text-sm">131 <span class="text-[10px] text-slate-500 font-normal">bpm</span></span>
        </div>
        <div class="flex items-center justify-between p-2 rounded-xl bg-slate-950 border border-slate-800">
          <span class="font-bold text-emerald-400">60% (有酸素ベース)</span>
          <span id="target60" class="font-mono font-bold text-white text-sm">145 <span class="text-[10px] text-slate-500 font-normal">bpm</span></span>
        </div>
        <div class="flex items-center justify-between p-2 rounded-xl bg-slate-950 border border-slate-800">
          <span class="font-bold text-amber-400">70% (持久力向上)</span>
          <span id="target70" class="font-mono font-bold text-white text-sm">159 <span class="text-[10px] text-slate-500 font-normal">bpm</span></span>
        </div>
        <div class="flex items-center justify-between p-2 rounded-xl bg-slate-950 border border-slate-800">
          <span class="font-bold text-orange-400">80% (無酸素作業閾値)</span>
          <span id="target80" class="font-mono font-bold text-white text-sm">174 <span class="text-[10px] text-slate-500 font-normal">bpm</span></span>
        </div>
        <div class="flex items-center justify-between p-2 rounded-xl bg-slate-950 border border-slate-800">
          <span class="font-bold text-rose-400">90% (高強度インターバル)</span>
          <span id="target90" class="font-mono font-bold text-white text-sm">188 <span class="text-[10px] text-slate-500 font-normal">bpm</span></span>
        </div>
        <div class="flex items-center justify-between p-2 rounded-xl bg-slate-950 border border-slate-800">
          <span class="font-bold text-purple-400">100% (最大負荷)</span>
          <span id="target100" class="font-mono font-bold text-white text-sm">202 <span class="text-[10px] text-slate-500 font-normal">bpm</span></span>
        </div>
      </div>
    </div>
  </main>

  <footer class="py-2 text-center text-[10px] text-slate-500 font-mono">
    Karvonen Formula Engine • 百武整形外科病院
  </footer>

  <script>
    const inputAge = document.getElementById('inputAge');
    const inputRestVal = document.getElementById('inputRestVal');
    const inputWorkVal = document.getElementById('inputWorkVal');

    // モード管理: 'watch' (bpm直接) or 'manual' (20秒カウント)
    let restMode = 'watch';
    let workMode = 'watch';

    // 安静時モード切替
    const restModeWatchBtn = document.getElementById('restModeWatchBtn');
    const restModeManualBtn = document.getElementById('restModeManualBtn');
    const restUnitLabel = document.getElementById('restUnitLabel');

    restModeWatchBtn.addEventListener('click', () => {
      restMode = 'watch';
      restModeWatchBtn.className = 'px-2 py-0.5 rounded font-bold bg-cyan-600 text-white transition-all';
      restModeManualBtn.className = 'px-2 py-0.5 rounded text-slate-400 hover:text-white transition-all';
      restUnitLabel.innerText = 'bpm';
      inputRestVal.value = '60';
      calculate();
    });

    restModeManualBtn.addEventListener('click', () => {
      restMode = 'manual';
      restModeManualBtn.className = 'px-2 py-0.5 rounded font-bold bg-cyan-600 text-white transition-all';
      restModeWatchBtn.className = 'px-2 py-0.5 rounded text-slate-400 hover:text-white transition-all';
      restUnitLabel.innerText = '回 / 20s';
      inputRestVal.value = '20';
      calculate();
    });

    // 運動後モード切替
    const workModeWatchBtn = document.getElementById('workModeWatchBtn');
    const workModeManualBtn = document.getElementById('workModeManualBtn');
    const workUnitLabel = document.getElementById('workUnitLabel');

    workModeWatchBtn.addEventListener('click', () => {
      workMode = 'watch';
      workModeWatchBtn.className = 'px-2 py-0.5 rounded font-bold bg-rose-600 text-white transition-all';
      workModeManualBtn.className = 'px-2 py-0.5 rounded text-slate-400 hover:text-white transition-all';
      workUnitLabel.innerText = 'bpm';
      inputWorkVal.value = '150';
      calculate();
    });

    workModeManualBtn.addEventListener('click', () => {
      workMode = 'manual';
      workModeManualBtn.className = 'px-2 py-0.5 rounded font-bold bg-rose-600 text-white transition-all';
      workModeWatchBtn.className = 'px-2 py-0.5 rounded text-slate-400 hover:text-white transition-all';
      workUnitLabel.innerText = '回 / 20s';
      inputWorkVal.value = '50';
      calculate();
    });

    // 計算メインロジック
    function calculate() {
      const age = parseFloat(inputAge.value) || 0;
      const rawRest = parseFloat(inputRestVal.value) || 0;
      const rawWork = parseFloat(inputWorkVal.value) || 0;

      const maxHr = Math.max(0, 220 - age);
      const restHr = (restMode === 'manual') ? rawRest * 3 : rawRest;
      const workHr = (workMode === 'manual') ? rawWork * 3 : rawWork;

      document.getElementById('maxHrLabel').innerText = maxHr;
      document.getElementById('restCalcLabel').innerText = Math.round(restHr);
      document.getElementById('workCalcLabel').innerText = Math.round(workHr);

      const hrr = Math.max(0, maxHr - restHr);
      const calcTarget = (pct) => Math.round(hrr * pct + restHr);

      document.getElementById('target50').innerHTML = `${calcTarget(0.50)} <span class="text-[10px] text-slate-500 font-normal">bpm</span>`;
      document.getElementById('target60').innerHTML = `${calcTarget(0.60)} <span class="text-[10px] text-slate-500 font-normal">bpm</span>`;
      document.getElementById('target70').innerHTML = `${calcTarget(0.70)} <span class="text-[10px] text-slate-500 font-normal">bpm</span>`;
      document.getElementById('target80').innerHTML = `${calcTarget(0.80)} <span class="text-[10px] text-slate-500 font-normal">bpm</span>`;
      document.getElementById('target90').innerHTML = `${calcTarget(0.90)} <span class="text-[10px] text-slate-500 font-normal">bpm</span>`;
      document.getElementById('target100').innerHTML = `${calcTarget(1.00)} <span class="text-[10px] text-slate-500 font-normal">bpm</span>`;

      let currentIntensity = 0;
      if (hrr > 0) {
        currentIntensity = Math.round(((workHr - restHr) / hrr) * 100);
      }
      document.getElementById('intensityVal').innerText = currentIntensity;

      const badge = document.getElementById('intensityZoneBadge');
      if (currentIntensity < 50) {
        badge.innerText = '軽運動・ウォームアップ (Zone 1)';
        badge.className = 'inline-block mt-2 px-2.5 py-0.5 rounded-md text-[10px] font-bold bg-cyan-950 text-cyan-300 border border-cyan-800 w-fit';
      } else if (currentIntensity < 70) {
        badge.innerText = '有酸素ベース構築・脂肪燃焼 (Zone 2)';
        badge.className = 'inline-block mt-2 px-2.5 py-0.5 rounded-md text-[10px] font-bold bg-emerald-950 text-emerald-300 border border-emerald-800 w-fit';
      } else if (currentIntensity < 85) {
        badge.innerText = '持久力・無酸素作業閾値向上 (Zone 3-4)';
        badge.className = 'inline-block mt-2 px-2.5 py-0.5 rounded-md text-[10px] font-bold bg-amber-950 text-amber-300 border border-amber-800 w-fit';
      } else {
        badge.innerText = '高強度インターバル・心肺限界 (Zone 5)';
        badge.className = 'inline-block mt-2 px-2.5 py-0.5 rounded-md text-[10px] font-bold bg-rose-950 text-rose-300 border border-rose-800 w-fit';
      }
    }

    [inputAge, inputRestVal, inputWorkVal].forEach(el => {
      el.addEventListener('input', calculate);
    });

    calculate();
  </script>
</body>
</html>
